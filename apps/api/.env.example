PORT=3001
DATABASE_URL=postgresql://dev:dev@localhost:5432/expensio
# Required for Supabase connection pooling. For local dev, set to the same value as DATABASE_URL.
DIRECT_URL=postgresql://dev:dev@localhost:5432/expensio
REDIS_URL=redis://:dev@localhost:6379
# Must be at least 32 characters
JWT_SECRET=replace-this-with-a-long-random-secret-key

WEB_URL=http://localhost:3000

# Optional — defaults shown
# NODE_ENV=development
# JWT_EXPIRY=15m
# REFRESH_TOKEN_EXPIRY=7d

# Future stories — not required yet
# ALCHEMY_API_KEY=
# PINATA_API_KEY=
# PINATA_SECRET_KEY=
